r_name": "Demo Cluster 1", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0090", "district": "District A", "block_name": "Demo Block 1", "cluster_name": "Demo Cluster 2", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0083", "district": "District A", "block_name": "Demo Block 2", "cluster_name": "Demo Cluster 3", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0084", "district": "District A", "block_name": "Demo Block 2", "cluster_name": "Demo Cluster 4", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0091", "district": "District A", "block_name": "Demo Block 2", "cluster_name": "Demo Cluster 3", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0092", "district": "District A", "block_name": "Demo Block 2", "cluster_name": "Demo Cluster 4", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0085", "district": "District B", "block_name": "Demo Block 3", "cluster_name": "Demo Cluster 5", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0086", "district": "District B", "block_name": "Demo Block 3", "cluster_name": "Demo Cluster 6", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0093", "district": "District B", "block_name": "Demo Block 3", "cluster_name": "Demo Cluster 5", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0094", "district": "District B", "block_name": "Demo Block 3", "cluster_name": "Demo Cluster 6", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0071", "district": "District B", "block_name": "Demo Block 4", "cluster_name": "Demo Cluster 7", "enrolment_year": "2026-2027", "fuzzy_original_score": 79, "bo_status": null, "action": "Review eligibility flag", "priority": 2}, {"case_id": "DEMO-0072", "district": "District B", "block_name": "Demo Block 4", "cluster_name": "Demo Cluster 8", "enrolment_year": "2026-2027", "fuzzy_original_score": 80, "bo_status": null, "action": "Review eligibility flag", "priority": 2}, {"case_id": "DEMO-0087", "district": "District B", "block_name": "Demo Block 4", "cluster_name": "Demo Cluster 7", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0088", "district": "District B", "block_name": "Demo Block 4", "cluster_name": "Demo Cluster 8", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}, {"case_id": "DEMO-0095", "district": "District B", "block_name": "Demo Block 4", "cluster_name": "Demo Cluster 7", "enrolment_year": "2025-2026", "fuzzy_original_score": null, "bo_status": null, "action": "Complete SR", "priority": 2}]}, {"id": "13", "title": "Enrolment by admission month", "note": "Admission dates do not imply verification-completion progress.", "sql": "SELECT district, admission_month, COUNT(*) AS main_enrolments FROM v_case_status WHERE in_main=1 GROUP BY district, admission_month ORDER BY district, admission_month;", "columns": ["district", "admission_month", "main_enrolments"], "rows": [{"district": "District A", "admission_month": "2026-04", "main_enrolments": 8}, {"district": "District A", "admission_month": "2026-05", "main_enrolments": 9}, {"district": "District A", "admission_month": "2026-06", "main_enrolments": 9}, {"district": "District A", "admission_month": "2026-07", "main_enrolments": 9}, {"district": "District A", "admission_month": "2026-08", "main_enrolments": 9}, {"district": "District A", "admission_month": "2026-09", "main_enrolments": 8}, {"district": "District B", "admission_month": "2026-04", "main_enrolments": 8}, {"district": "District B", "admission_month": "2026-05", "main_enrolments": 8}, {"district": "District B", "admission_month": "2026-06", "main_enrolments": 8}, {"district": "District B", "admission_month": "2026-07", "main_enrolments": 8}, {"district": "District B", "admission_month": "2026-08", "main_enrolments": 8}, {"district": "District B", "admission_month": "2026-09", "main_enrolments": 8}]}, {"id": "14", "title": "Current-year quality proxy", "note": "The proxy is a reconciliation check; it does not overwrite the supplied flag.", "sql": "SELECT district, COUNT(*) AS current_main, SUM(CASE WHEN quality_status='Yes' THEN 1 ELSE 0 END) AS quality_flag_yes, SUM(current_eligibility_proxy) AS eligibility_proxy FROM v_case_status WHERE in_main=1 AND enrolment_year='2026-2027' GROUP BY district ORDER BY district;", "columns": ["district", "current_main", "quality_flag_yes", "eligibility_proxy"], "rows": [{"district": "District A", "current_main": 40, "quality_flag_yes": 36, "eligibility_proxy": 37}, {"district": "District B", "current_main": 40, "quality_flag_yes": 34, "eligibility_proxy": 36}]}, {"id": "15", "title": "Eligibility flag mismatch", "note": "Find records meeting the available proxy but not marked Yes.", "sql": "SELECT case_id, district, block_name, sr_status, quality_status FROM v_case_status WHERE in_main=1 AND current_eligibility_proxy=1 AND quality_status<>'Yes' ORDER BY district, case_id;", "columns": ["case_id", "district", "block_name", "sr_status", "quality_status"], "rows": [{"case_id": "DEMO-0073", "district": "District A", "block_name": "Demo Block 1", "sr_status": "Pending Seal sign generation", "quality_status": "Not recorded"}, {"case_id": "DEMO-0071", "district": "District B", "block_name": "Demo Block 4", "sr_status": "Pending Seal sign generation", "quality_status": "Not recorded"}, {"case_id": "DEMO-0072", "district": "District B", "block_name": "Demo Block 4", "sr_status": "Pending Seal sign generation", "quality_status": "Not recorded"}]}, {"id": "16", "title": "Explicit CV completion", "note": "Count only explicit Yes fields; no unknown status is treated as completion.", "sql": "SELECT district, SUM(CASE WHEN in_main=1 AND main_cv_status='Yes' THEN 1 ELSE 0 END) AS completed_cv_main, SUM(CASE WHEN in_queue=1 AND queue_cv_status='Yes' THEN 1 ELSE 0 END) AS completed_cv_queue FROM v_case_status GROUP BY district ORDER BY district;", "columns": ["district", "completed_cv_main", "completed_cv_queue"], "rows": [{"district": "District A", "completed_cv_main": 2, "completed_cv_queue": 1}, {"district": "District B", "completed_cv_main": 0, "completed_cv_queue": 0}]}, {"id": "17", "title": "Duplicate source IDs", "note": "Primary keys reject duplicate inserts; this check should return no rows.", "sql": "SELECT 'enrolments' AS source, case_id, COUNT(*) AS row_count FROM enrolments GROUP BY case_id HAVING COUNT(*)>1 UNION ALL SELECT 'fuzzy_matches', case_id, COUNT(*) FROM fuzzy_matches GROUP BY case_id HAVING COUNT(*)>1 UNION ALL SELECT 'verification_queue', case_id, COUNT(*) FROM verification_queue GROUP BY case_id HAVING COUNT(*)>1;", "columns": ["source", "case_id", "row_count"], "rows": []}, {"id": "18", "title": "Missing case references", "note": "Foreign keys enforce this relationship; the audit should return no rows.", "sql": "SELECT 'enrolments' AS source, e.case_id FROM enrolments e LEFT JOIN case_registry c ON e.case_id=c.case_id WHERE c.case_id IS NULL UNION ALL SELECT 'fuzzy_matches', f.case_id FROM fuzzy_matches f LEFT JOIN case_registry c ON f.case_id=c.case_id WHERE c.case_id IS NULL UNION ALL SELECT 'verification_queue', q.case_id FROM verification_queue q LEFT JOIN case_registry c ON q.case_id=c.case_id WHERE c.case_id IS NULL;", "columns": ["source", "case_id"], "rows": []}]}