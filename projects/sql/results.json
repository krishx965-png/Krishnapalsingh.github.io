{"synthetic": true, "queries": [{"id": "01", "title": "Source populations", "note": "Keep overlapping export counts separate.", "sql": "SELECT COUNT(*) AS case_universe, SUM(in_main) AS main_records, SUM(in_fuzzy) AS fuzzy_records, SUM(in_queue) AS queue_records FROM v_case_status;", "columns": ["case_universe", "main_records", "fuzzy_records", "queue_records"], "rows": [{"case_universe": 111, "main_records": 100, "fuzzy_records": 90, "queue_records": 11}]}, {"id": "02", "title": "District status", "note": "Compare each district using the same definitions.", "sql": "SELECT * FROM v_district_status ORDER BY district;", "columns": ["district", "main_enrolments", "fuzzy_cases", "queue_cases", "quality_yes", "incomplete_sr", "low_original", "low_original_queued", "low_original_not_queued", "completed_cv_main"], "rows": [{"district": "District A", "main_enrolments": 52, "fuzzy_cases": 44, "queue_cases": 4, "quality_yes": 36, "incomplete_sr": 8, "low_original": 10, "low_original_queued": 4, "low_original_not_queued": 6, "completed_cv_main": 2}, {"district": "District B", "main_enrolments": 48, "fuzzy_cases": 46, "queue_cases": 7, "quality_yes": 34, "incomplete_sr": 7, "low_original": 10, "low_original_queued": 6, "low_original_not_queued": 4, "completed_cv_main": 0}]}, {"id": "03", "title": "Quality and SR rates", "note": "Blank quality flags are not recorded, not failures.", "sql": "SELECT district, main_enrolments, quality_yes, ROUND(100.0*quality_yes/NULLIF(main_enrolments,0),1) AS quality_flag_pct, incomplete_sr, ROUND(100.0*incomplete_sr/NULLIF(main_enrolments,0),1) AS incomplete_sr_pct FROM v_district_status ORDER BY district;", "columns": ["district", "main_enrolments", "quality_yes", "quality_flag_pct", "incomplete_sr", "incomplete_sr_pct"], "rows": [{"district": "District A", "main_enrolments": 52, "quality_yes": 36, "quality_flag_pct": 69.2, "incomplete_sr": 8, "incomplete_sr_pct": 15.4}, {"district": "District B", "main_enrolments": 48, "quality_yes": 34, "quality_flag_pct": 70.8, "incomplete_sr": 7, "incomplete_sr_pct": 14.6}]}, {"id": "04", "title": "Low fuzzy queue coverage", "note": "Only low original-score IDs actually in queue belong in the numerator.", "sql": "SELECT district, low_original, low_original_queued, low_original_not_queued, ROUND(100.0*low_original_queued/NULLIF(low_original,0),1) AS queue_coverage_pct FROM v_district_status ORDER BY district;", "columns": ["district", "low_original", "low_original_queued", "low_original_not_queued", "queue_coverage_pct"], "rows": [{"district": "District A", "low_original": 10, "low_original_queued": 4, "low_original_not_queued": 6, "queue_coverage_pct": 40.0}, {"district": "District B", "low_original": 10, "low_original_queued": 6, "low_original_not_queued": 4, "queue_coverage_pct": 60.0}]}, {"id": "05", "title": "BO workflow status", "note": "Queue membership and approval are distinct from completed CV.", "sql": "SELECT district, bo_status, COUNT(*) AS cases FROM v_case_status WHERE in_queue=1 GROUP BY district, bo_status ORDER BY district, bo_status;", "columns": ["district", "bo_status", "cases"], "rows": [{"district": "District A", "bo_status": "Approved", "cases": 1}, {"district": "District A", "bo_status": "Pending for Approval/Rejection", "cases": 3}, {"district": "District B", "bo_status": "Pending for Approval/Rejection", "cases": 6}, {"district": "District B", "bo_status": "Unmatch", "cases": 1}]}, {"id": "06", "title": "Score distribution", "note": "Original fuzzy export population; missing scores retain their own category.", "sql": "WITH bands AS (SELECT district, CASE WHEN fuzzy_original_score IS NULL THEN 'Missing' WHEN fuzzy_original_score<30 THEN '<30' WHEN fuzzy_original_score<70 THEN '30-69' WHEN fuzzy_original_score<100 THEN '70-99' ELSE '100' END AS score_band FROM v_case_status WHERE in_fuzzy=1) SELECT district, score_band, COUNT(*) AS cases FROM bands GROUP BY district, score_band ORDER BY district, score_band;", "columns": ["district", "score_band", "cases"], "rows": [{"district": "District A", "score_band": "30-69", "cases": 10}, {"district": "District A", "score_band": "70-99", "cases": 34}, {"district": "District B", "score_band": "100", "cases": 2}, {"district": "District B", "score_band": "30-69", "cases": 10}, {"district": "District B", "score_band": "70-99", "cases": 34}]}, {"id": "07", "title": "Original versus new scores", "note": "Different score methods, not a historical trend.", "sql": "SELECT district, SUM(CASE WHEN fuzzy_original_score<70 THEN 1 ELSE 0 END) AS low_original, SUM(CASE WHEN fuzzy_new_score<70 THEN 1 ELSE 0 END) AS low_new, ROUND(AVG(fuzzy_original_score),1) AS avg_original, ROUND(AVG(fuzzy_new_score),1) AS avg_new FROM v_case_status WHERE in_fuzzy=1 GROUP BY district ORDER BY district;", "columns": ["district", "low_original", "low_new", "avg_original", "avg_new"], "rows": [{"district": "District A", "low_original": 10, "low_new": 16, "avg_original": 79.8, "avg_new": 77.2}, {"district": "District B", "low_original": 10, "low_new": 13, "avg_original": 79.7, "avg_new": 77.7}]}, {"id": "08", "title": "Source intersections", "note": "Reconcile overlaps before building enrolment totals.", "sql": "SELECT SUM(CASE WHEN in_main=1 AND in_fuzzy=1 THEN 1 ELSE 0 END) AS main_and_fuzzy, SUM(CASE WHEN in_main=1 AND in_fuzzy=0 THEN 1 ELSE 0 END) AS main_outside_fuzzy, SUM(CASE WHEN in_main=0 AND in_fuzzy=1 THEN 1 ELSE 0 END) AS fuzzy_outside_main, SUM(CASE WHEN in_main=1 AND in_queue=1 THEN 1 ELSE 0 END) AS queue_and_main, SUM(CASE WHEN in_main=0 AND in_queue=1 THEN 1 ELSE 0 END) AS queue_outside_main FROM v_case_status;", "columns": ["main_and_fuzzy", "main_outside_fuzzy", "fuzzy_outside_main", "queue_and_main", "queue_outside_main"], "rows": [{"main_and_fuzzy": 80, "main_outside_fuzzy": 20, "fuzzy_outside_main": 10, "queue_and_main": 0, "queue_outside_main": 11}]}, {"id": "09", "title": "Low fuzzy outside queue", "note": "Anti-join pattern identifies follow-up cases.", "sql": "SELECT c.case_id, l.district, l.block_name, l.cluster_name, f.original_score FROM fuzzy_matches f JOIN case_registry c ON c.case_id=f.case_id JOIN locations l ON l.location_key=c.location_key WHERE f.original_score<70 AND NOT EXISTS (SELECT 1 FROM verification_queue q WHERE q.case_id=f.case_id) ORDER BY l.district, l.block_name, c.case_id;", "columns": ["case_id", "district", "block_name", "cluster_name", "original_score"], "rows": [{"case_id": "DEMO-0001", "district": "District A", "block_name": "Demo Block 1", "cluster_name": "Demo Cluster 1", "original_score": 56}, {"case_id": "DEMO-0002", "district": "District A", "block_name": "Demo Block 1", "cluster_name": "Demo Cluster 2", "original_score": 57}, {"case_id": "DEMO-0009", "district": "District A", "block_name": "Demo Block 1", "cluster_name": "Demo Cluster 1", "original_score": 64}, {"case_id": "DEMO-0010", "district": "District A", "block_name": "Demo Block 1", "cluster_name": "Demo Cluster 2", "original_score": 65}, {"case_id": "DEMO-0003", "district": "District A", "block_name": "Demo Block 2", "cluster_name": "Demo Cluster 3", "original_score": 58}, {"case_id": "DEMO-0004", "district": "District A", "block_name": "Demo Block 2", "cluster_name": "Demo Cluster 4", "original_score": 59}, {"case_id": "DEMO-0005", "district": "District B", "block_name": "Demo Block 3", "cluster_name": "Demo Cluster 5", "original_score": 60}, {"case_id": "DEMO-0006", "district": "District B", "block_name": "Demo Block 3", "cluster_name": "Demo Cluster 6", "original_score": 61}, {"case_id": "DEMO-0007", "district": "District B", "block_name": "Demo Block 4", "cluster_name": "Demo Cluster 7", "original_score": 62}, {"case_id": "DEMO-0008", "district": "District B", "block_name": "Demo Block 4", "cluster_name": "Demo Cluster 8", "original_score": 63}]}, {"id": "10", "title": "Quality missing by block", "note": "Missing quality flags need reconciliation, not automatic rejection.", "sql": "SELECT district, block_name, COUNT(*) AS main_records, SUM(CASE WHEN quality_status='Not recorded' THEN 1 ELSE 0 END) AS quality_missing FROM v_case_status WHERE in_main=1 GROUP BY district, block_name ORDER BY district, block_name;", "columns": ["district", "block_name", "main_records", "quality_missing"], "rows": [{"district": "District A", "block_name": "Demo Block 1", "main_records": 26, "quality_missing": 8}, {"district": "District A", "block_name": "Demo Block 2", "main_records": 26, "quality_missing": 8}, {"district": "District B", "block_name": "Demo Block 3", "main_records": 24, "quality_missing": 6}, {"district": "District B", "block_name": "Demo Block 4", "main_records": 24, "quality_missing": 8}]}, {"id": "11", "title": "Rank follow-up blocks", "note": "DENSE_RANK preserves ties within each district.", "sql": "WITH block_actions AS (SELECT district, block_name, COUNT(*) AS action_cases FROM v_priority_cases WHERE priority<3 GROUP BY district, block_name) SELECT district, block_name, action_cases, DENSE_RANK() OVER (PARTITION BY district ORDER BY action_cases DESC) AS priority_rank FROM block_actions ORDER BY district, priority_rank, block_name;", "columns": ["district", "block_name", "action_cases", "priority_rank"], "rows": [{"district": "District A", "block_name": "Demo Block 1", "action_cases": 11, "priority_rank": 1}, {"district": "District A", "block_name": "Demo Block 2", "action_cases": 7, "priority_rank": 2}, {"district": "District B", "block_name": "Demo Block 3", "action_cases": 10, "priority_rank": 1}, {"district": "District B", "block_name": "Demo Block 4", "action_cases": 10, "priority_rank": 1}]}, {"id": "12", "title": "Private action list", "note": "Cases retain stable pseudonymous IDs for safe analysis.", "sql": "SELECT * FROM v_priority_cases WHERE priority<3 ORDER BY priority, district, block_name, case_id;", "columns": ["case_id", "district", "block_name", "cluster_name", "enrolment_year", "fuzzy_original_score", "bo_status", "action", "priority"], "rows": [{"case_id": "DEMO-0001", "district": "District A", "block_name": "Demo Block 1", "cluster_name": "Demo Cluster 1", "enrolment_year": "2026-2027", "fuzzy_original_score": 56, "bo_status": null, "action": "Low original score: not in queue", "priority": 1}, {"case_id": "DEMO-0002", "district": "District A", "block_name": "Demo Block 1", "cluster_name": "Demo Cluster 2", "enrolment_year": "2026-2027", "fuzzy_original_score": 57, "bo_status": null, "action": "Low original score: not in queue", "priority": 1}, {"case_id": "DEMO-0009", "district": "District A", "block_name": "Demo Block 1", "cluster_name": "Demo Cluster 1", "enrolment_year": "2026-2027", "fuzzy_original_score": 64, "bo_status": null, "action": "Low original score: not in queue", "priority": 1}, {"case_id": "DEMO-0010", "district": "District A", "block_name": "Demo Block 1", "cluster_name": "Demo Cluster 2", "enrolment_year": "2026-2027", "fuzzy_original_score": 65, "bo_status": null, "action": "Low original score: not in queue", "priority": 1}, {"case_id": "DEMO-0105", "district": "District A", "block_name": "Demo Block 1", "cluster_name": "Demo Cluster 1", "enrolment_year": "2026-2027", "fuzzy_original_score": 62, "bo_status": "Pending for Approval/Rejection", "action": "BO approval pending", "priority": 1}, {"case_id": "DEMO-0106", "district": "District A", "block_name": "Demo Block 1", "cluster_name": "Demo Cluster 2", "enrolment_year": "2026-2027", "fuzzy_original_score": 63, "bo_status": "Pending for Approval/Rejection", "action": "BO approval pending", "priority": 1}, {"case_id": "DEMO-0003", "district": "District A", "block_name": "Demo Block 2", "cluster_name": "Demo Cluster 3", "enrolment_year": "2026-2027", "fuzzy_original_score": 58, "bo_status": null, "action": "Low original score: not in queue", "priority": 1}, {"case_id": "DEMO-0004", "district": "District A", "block_name": "Demo Block 2", "cluster_name": "Demo Cluster 4", "enrolment_year": "2026-2027", "fuzzy_original_score": 59, "bo_status": null, "action": "Low original scor